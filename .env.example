# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Firebase Realtime Database REST API URL (Shared between Desktop EXE & Mobile/Web PWA)
# Example: https://makka-footprint-bot-default-rtdb.firebaseio.com
VITE_FIREBASE_RTDB_URL="https://YOUR-PROJECT-default-rtdb.firebaseio.com"

# Optional server-side AES-256-GCM Vault passphrase & Webhook shared secret
# MAKKA_VAULT_SECRET="your-32-char-random-vault-secret"
# WEBHOOK_SECRET="your-webhook-auth-secret"

