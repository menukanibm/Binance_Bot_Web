{
  "name": "makka-footprint-bot",
  "private": true,
  "version": "1.2.1",
  "description": "MAKKA Bot - Pure 6-Rule MSNR + HTF Market-History Context Trading Bot for Binance USD-M & MEXC Futures",
  "author": "Makka Quantitative Systems",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "tsx server.ts",
    "build:ui": "vite build",
    "build:server": "esbuild server.ts --bundle --platform=node --format=cjs --outfile=dist-server/server.cjs --external:vite --external:fsevents --external:electron",
    "build": "npm run build:ui && npm run build:server",
    "start": "tsx server.ts",
    "preview": "vite preview",
    "clean": "rimraf dist dist-server release",
    "lint": "tsc --noEmit",
    "electron:dev": "cross-env NODE_ENV=development concurrently -k -s first \"npm run dev\" \"wait-on http://127.0.0.1:3000 && electron .\"",
    "electron:pack": "npm run build && electron-builder --dir",
    "electron:build": "npm run build && electron-builder --win --x64",
    "electron:dist": "npm run build && electron-builder --win nsis portable --x64",
    "build:exe": "npm run build && electron-builder --win nsis portable --x64",
    "build:mobile": "npm run build:ui",
    "cap:sync": "npm run build:ui && npx cap sync",
    "cap:android": "npm run build:ui && npx cap open android",
    "cap:ios": "npm run build:ui && npx cap open ios"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/cli": "^8.6.0",
    "@capacitor/core": "^8.6.0",
    "@supabase/supabase-js": "^2.118.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "ccxt": "^4.5.90",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "firebase": "^13.2.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "protobufjs": "^7.4.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.5.12",
    "autoprefixer": "^10.4.21",
    "concurrently": "^10.0.6",
    "cross-env": "^10.1.0",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.25.0",
    "rimraf": "^6.0.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "wait-on": "^9.5.1"
  },
  "build": {
    "appId": "com.makka.footprintbot",
    "productName": "Makka Depth Sniper Entries",
    "copyright": "Copyright © 2026 Makka",
    "npmRebuild": false,
    "asar": true,
    "publish": null,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-server/**/*",
      "electron/**/*",
      "package.json",
      "!node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": ".env.example",
        "to": ".env.example"
      },
      {
        "from": "release/Makka-Footprint-Bot-1.2.1.apk",
        "to": "Makka-Footprint-Bot-1.2.1.apk"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "artifactName": "Makka-Footprint-Bot-Setup-${version}-${arch}.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Makka Depth Sniper Entries"
    },
    "portable": {
      "artifactName": "Makka-Footprint-Bot-Portable-${version}-${arch}.${ext}"
    }
  }
}
